        {"name": "EDGE-CORE2", "subnet": "10.10.255.4/30", "a": {"device": "R-EDGE", "intf": "GigabitEthernet0/0/2", "ip": "10.10.255.5"}, "b": {"device": "CORE2", "intf": "GigabitEthernet1/0/1", "ip": "10.10.255.6"}}
