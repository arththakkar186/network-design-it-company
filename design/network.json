         "port_groups": [
           {"range": "FastEthernet0/1-12",  "vlan": 40, "voice": 60, "desc": "ENGINEERING desks"},
           {"range": "FastEthernet0/13-18", "vlan": 25, "voice": 60, "desc": "IT-OPS desks"},
           {"range": "FastEthernet0/19",    "vlan": 90, "hub": true, "desc": "Uplink to training-lab hub (shared collision domain)"},
