        {"name": "ACC-DC-01", "model": "Catalyst 2960-24TT-L", "mgmt_ip": "10.10.10.14", "floor": 1, "location": "Server room MDF, rack 2", "uplinks": {"CORE1": "GigabitEthernet0/1", "CORE2": "GigabitEthernet0/2"}, "core_ports": {"CORE1": "GigabitEthernet1/0/5", "CORE2": "GigabitEthernet1/0/5"},         "port_groups": [
           {"range": "FastEthernet0/1-12",  "vlan": 50, "server": true, "desc": "Servers"},
           {"range": "FastEthernet0/13",    "wlc_trunk": true, "vlans": [10, 70, 80], "desc": "WLC01 (Cisco 2504) trunk: management + both SSID VLANs"},
           {"range": "FastEthernet0/14-17", "vlan": 10, "server": true, "desc": "Server iLO/iDRAC out-of-band management"},
           {"range": "FastEthernet0/18-24", "unused": true}
